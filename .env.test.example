# Safe local/CI test profile. This file intentionally contains no secrets.
APP_ENV=test
GOOGLE_API_KEY=test-key-not-used
GOOGLE_IMAGE_API_KEY=
GOOGLE_MODEL=fake-model
AI_TEMPERATURE=0
PROMPT_VERSION=test-fixture-v1

# The test runner replaces these with a unique directory per run.
TEST_DATA_DIR=./tmp/test-run
OUTPUT_DIR=./tmp/test-run/output
SKOLEVERKSTED_DB_PATH=./tmp/test-run/platform.sqlite3
DATABASE_URL=
REDIS_URL=

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
APP_PASSWORD=test-password
MATE_API_KEY=test-mate-key

QUALITY_GATE_MODEL_TIMEOUT_SECONDS=1
QUALITY_GATE_TIMEOUT_SECONDS=5
QUALITY_GATE_MAX_MODEL_ATTEMPTS=1
QUALITY_GATE_MAX_REVISION_ROUNDS=2
