# Shared AI provider (required for generation)
GOOGLE_API_KEY=
# Optional separate key for paid image calls; falls back to GOOGLE_API_KEY.
GOOGLE_IMAGE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
AI_TEMPERATURE=0.35
PROMPT_VERSION=skoleverksted-v2

# Optional common frontend origin
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SKOLEVERKSTED_PUBLIC_FRONTEND_URL=https://skoleverksted-3npg.vercel.app

# Shared access code for the closed pilot. When set, EVERY API route (Fag, Norsk,
# Matematikk and the platform) requires it; in production a missing code fails
# closed. Teachers trade the code for a signed token that expires after
# ACCESS_TOKEN_TTL_HOURS (default 12, max 168). Changing the code revokes all
# tokens. Use a long random value (12+ characters).
APP_PASSWORD=
ACCESS_TOKEN_TTL_HOURS=12
# Server-side key shared with the Vercel mathematics proxy (required in production)
MATE_API_KEY=

# Optional persistence
DATABASE_URL=
REDIS_URL=
# Optional distributed job-capacity lease for more than one backend instance.
REDIS_JOB_LEASE_KEY=skoleverksted:jobs:active
REDIS_JOB_LEASE_SECONDS=3600
OUTPUT_DIR=./output
SKOLEVERKSTED_DB_PATH=./output/platform/skoleverksted.sqlite3

# Optional explicit executable paths (the production Docker image sets these)
TYPST_PATH=typst
PDFLATEX_PATH=pdflatex

# Keep concurrency low on memory-constrained hosts
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_COMPILES=2

# Norsklæring splits sentences that are too long for the CEFR level with one extra
# model call before the truth gate. Set to 0 to switch it off (saves one call per sheet).
FOV_READABILITY_REPAIR=1
